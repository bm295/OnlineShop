{
  "name": "onlineshop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/storefront",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint apps packages",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test"
  }
}
