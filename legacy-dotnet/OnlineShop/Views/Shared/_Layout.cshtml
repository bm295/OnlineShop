<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shop Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <h1>Shop Management</h1>
        <nav>
            <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a asp-controller="Categories" asp-action="Index">Categories</a>
            <a asp-controller="Products" asp-action="Index">Products</a>
            <a asp-controller="Orders" asp-action="Index">Orders</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
